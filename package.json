{
  "devDependencies": {
    "@astralsight/astroforge": "^0.0.6",
    "@rsbuild/core": "^2.0.0",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.0.0"
  },
  "name": "astroforge-app",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:vela-tailwind": "node scripts/generate-vela-tailwind.mjs",
    "build": "pnpm generate:vela-tailwind && astroforge build --target vela",
    "release": "pnpm generate:vela-tailwind && astroforge release --target vela",
    "dev": "pnpm generate:vela-tailwind && astroforge dev",
    "inspect": "astroforge inspect rpk dist/*.debug.rpk"
  },
  "dependencies": {
    "@astralsight/astroforge-core": "^0.0.6",
    "@astralsight/astroforge-rsbuild-plugin": "^0.0.6"
  }
}
